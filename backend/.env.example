# 数据库类型：sqlite（默认）或 mysql
DB_TYPE=sqlite
SQLITE_FILE=./data/app.db
MYSQL_URL=mysql+aiomysql://root:root@localhost:3306/jump_rope

# JWT 与后台管理（默认 admin / coding61）
JWT_SECRET=jump_rope_jwt_secret_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=coding61

# 视频限制
MAX_VIDEO_DURATION_SEC=120
MAX_UPLOAD_BYTES=209715200
DAILY_UPLOAD_LIMIT=1

# AI 分析：real（MediaPipe 姿态估计+计数，默认）或 mock（联调用启发式）
JUMP_AI_MODE=real
# 姿态采样帧率与模型复杂度（0 最快 / 1 平衡 / 2 最准）
POSE_SAMPLE_FPS=24
POSE_MODEL_COMPLEXITY=1

# 七牛 CDN（frontend `npm run deploy` + 媒体上传）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_CDN_DOMAIN=https://static1.cxy61.com
QINIU_FRONTEND_PREFIX=jump-rope
QINIU_MEDIA_PREFIX=jump-rope-media
QINIU_REGION=z0

# 七牛数据库备份
QINIU_BACKUP_PREFIX=jump-rope-backup
QINIU_BACKUP_SLOTS=5
DB_BACKUP_SCHEDULE_HOUR=2
DB_BACKUP_SCHEDULE_MINUTE=0
DB_BACKUP_RETRY_DELAY_SECONDS=1800
DB_BACKUP_OUTPUT_DIR=/home/binch
DB_BACKUP_KEEP_LOCAL=0

# Worker 间隔（秒）
TRANSCODE_WORKER_INTERVAL_SECONDS=5
SCORE_WORKER_INTERVAL_SECONDS=10
SETTLE_WORKER_INTERVAL_SECONDS=60
